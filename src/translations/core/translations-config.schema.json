          "mn",
          "mr",
          "ms",
          "mt",
          "my",
          "nb",
          "ne",
          "nl",
          "no",
          "ny",
          "or",
          "pa",
          "pl",
          "ps",
          "pt",
          "pt_br",
          "pt_pt",
          "ro",
          "ru",
          "rw",
          "sd",
          "si",
          "sk",
          "sl",
          "sm",
          "sn",
          "so",
          "sq",
          "sr",
          "st",
          "su",
          "sv",
          "sw",
          "ta",
          "te",
          "tg",
          "th",
          "tk",
          "tl",
          "tr",
          "tt",
          "ug",
          "uk",
          "ur",
          "uz",
          "vi",
          "xh",
          "yi",
          "yo",
          "zh",
          "zh_cn",
          "zh_hans",
          "zh_hant",
          "zh_tw",
          "zu"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["en"]
    },
    "sourceLanguage": {
      "type": "string",
      "description": "Source language for translations (usually \"en\")",
      "enum": [
        "af",
        "am",
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "bs",
        "ca",
        "ceb",
        "co",
        "cs",
        "cy",
        "da",
        "de",
        "el",
        "en",
        "en_gb",
        "en_us",
        "eo",
        "es",
        "es_419",
        "et",
        "eu",
        "fa",
        "fi",
        "fr",
        "fy",
        "ga",
        "gd",
        "gl",
        "gu",
        "ha",
